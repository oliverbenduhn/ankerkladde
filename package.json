{
  "name": "ankerkladde",
  "private": true,
  "scripts": {
    "build:vendor": "bash scripts/build-vendor-assets.sh",
    "dev:demo": "bash scripts/demo-test-server.sh",
    "test:assets": "node scripts/check-ui-sprite.js && test -s public/vendor/editors/tiptap.js && test -s public/vendor/editors/sketch.js",
    "test:unit": "node --test scripts/test-item-content-conflict.mjs",
    "test:cache-versions": "php scripts/check-js-cache-versions.php",
    "test:i18n": "php scripts/check-i18n-keys.php",
    "test:design": "php scripts/check-design-token-stamp.php",
    "test:secrets": "php scripts/test-secret-storage.php",
    "test:ui": "playwright test --project=desktop --project=mobile",
    "test:ui:legacy": "playwright test --project=legacy",
    "test:ui:headed": "playwright test --project=desktop --project=mobile --headed",
    "test:ui:debug": "playwright test --project=desktop --project=mobile --debug",
    "test:ui:install": "playwright install chromium"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.17.3",
    "@playwright/test": "^1.62.1",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "esbuild": "^0.25.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
